//
// Example parameters file for WholeGenomeGermlineSingleSampleFastq Nextflow pipeline
//

params {
    // Input FASTQ files
    input_fastq_r1 = "/path/to/sample_R1.fastq.gz"
    input_fastq_r2 = "/path/to/sample_R2.fastq.gz"
    
    // Sample information
    sample_name = "NA12878"
    base_file_name = "NA12878"
    final_gvcf_base_name = "NA12878"
    
    // Read group information
    read_group_id = "H0164.2"  // Should be unique for each run
    read_group_platform = "ILLUMINA"
    read_group_pu = "H0164ALXX140820.2"  // Platform unit (flowcell barcode.lane)
    read_group_library = "Solexa-272222"
    read_group_center = "BI"
    
    // Reference genome files (hg38)
    reference_fasta = "/path/to/references/Homo_sapiens_assembly38.fasta"
    reference_fasta_index = "/path/to/references/Homo_sapiens_assembly38.fasta.fai"
    reference_dict = "/path/to/references/Homo_sapiens_assembly38.dict"
    
    // BWA index files
    reference_alt = "/path/to/references/Homo_sapiens_assembly38.fasta.64.alt"
    reference_amb = "/path/to/references/Homo_sapiens_assembly38.fasta.64.amb"
    reference_ann = "/path/to/references/Homo_sapiens_assembly38.fasta.64.ann"
    reference_bwt = "/path/to/references/Homo_sapiens_assembly38.fasta.64.bwt"
    reference_pac = "/path/to/references/Homo_sapiens_assembly38.fasta.64.pac"
    reference_sa = "/path/to/references/Homo_sapiens_assembly38.fasta.64.sa"
    
    // Known variant sites for BQSR
    dbsnp_vcf = "/path/to/references/Homo_sapiens_assembly38.dbsnp138.vcf"
    dbsnp_vcf_index = "/path/to/references/Homo_sapiens_assembly38.dbsnp138.vcf.idx"
    
    known_indels_sites_vcfs = [
        "/path/to/references/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz",
        "/path/to/references/Homo_sapiens_assembly38.known_indels.vcf.gz"
    ]
    known_indels_sites_indices = [
        "/path/to/references/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz.tbi",
        "/path/to/references/Homo_sapiens_assembly38.known_indels.vcf.gz.tbi"
    ]
    
    // Interval lists
    calling_interval_list = "/path/to/references/wgs_calling_regions.hg38.interval_list"
    evaluation_interval_list = "/path/to/references/wgs_evaluation_regions.hg38.interval_list"
    wgs_coverage_interval_list = "/path/to/references/wgs_coverage_regions.hg38.interval_list"
    
    // Contamination check files
    contamination_sites_ud = "/path/to/references/Homo_sapiens_assembly38.contamination.UD"
    contamination_sites_bed = "/path/to/references/Homo_sapiens_assembly38.contamination.bed"
    contamination_sites_mu = "/path/to/references/Homo_sapiens_assembly38.contamination.mu"
    haplotype_database_file = "/path/to/references/Homo_sapiens_assembly38.haplotype_database.txt"
    
    // Optional files (set to null if not available)
    fingerprint_genotypes_file = null
    fingerprint_genotypes_index = null
    
    // Optional DRAGMAP reference files (for DRAGEN mode)
    dragmap_reference_bin = null
    dragmap_hash_table_cfg_bin = null
    dragmap_hash_table_cmp = null
    
    // Pipeline options
    provide_bam_output = false                      // Set to true if you need final BAM files
    use_gatk3_haplotype_caller = false              // Use GATK4 by default
    dragen_functional_equivalence_mode = false      // DRAGEN compatibility mode
    dragen_maximum_quality_mode = false             // DRAGEN max quality mode
    run_dragen_mode_variant_calling = false         // Use DRAGEN mode variant calling
    use_spanning_event_genotyping = true            // Enable spanning event genotyping
    unmap_contaminant_reads = true                  // Unmap contaminated reads
    perform_bqsr = true                            // Perform base quality score recalibration
    aligner = "dragmap"                            // Aligner to use ("dragmap" or "bwa-mem")
    use_dragen_hard_filtering = false              // Apply DRAGEN hard filtering
    
    // Scatter settings (for future parallelization)
    haplotype_scatter_count = 50
    break_bands_at_multiples_of = 1000000
    
    // Output directory
    outdir = "results"
    
    // Resource limits
    max_cpus = 16
    max_memory = "64.GB"
    max_time = "240.h"
}
